###############################################################################
# Stage 1 — build
# Installs ALL dependencies (including dev) and compiles the admin panel.
###############################################################################
FROM node:22-bookworm-slim AS builder
 
# Build toolchain for native modules (sharp, better-sqlite3).
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 build-essential \
    && rm -rf /var/lib/apt/lists/*
 
WORKDIR /app
 
# Copy manifests first so this layer is cached until dependencies change.
COPY package*.json ./
RUN npm ci
 
COPY . .
 
# Strapi compiles the admin panel into the image at build time.
# NODE_ENV must be production here or you get a dev build.
ENV NODE_ENV=production
RUN npm run build
 
 
###############################################################################
# Stage 2 — runtime
# Copies the built app, then drops dev dependencies.
###############################################################################
FROM node:22-bookworm-slim AS runtime
 
# Runtime libs only: libvips for sharp, tini for correct signal handling.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libvips42 tini \
    && rm -rf /var/lib/apt/lists/*
 
ENV NODE_ENV=production
WORKDIR /app
 
# Copy the whole built app rather than guessing at ./dist vs ./build —
# those paths differ between Strapi v4/v5 and JS/TS projects.
COPY --from=builder --chown=node:node /app ./
 
# Remove dev dependencies now that the build is done.
RUN npm prune --omit=dev && npm cache clean --force
 
# Persist uploads and (if using SQLite) the database file.
RUN mkdir -p /app/public/uploads /app/.tmp && chown -R node:node /app/public/uploads /app/.tmp
 
USER node
EXPOSE 1337
 
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:1337/_health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
 
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npm", "run", "start"]
